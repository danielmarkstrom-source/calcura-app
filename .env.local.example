# Kopiera den här filen till .env.local (git-ignorerad) och fyll i värdena
# från Supabase-dashboarden: Project Settings -> API.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY är en publik klientnyckel (skyddas av Row Level
# Security i databasen), inte en hemlighet - men lägg ändå aldrig den riktiga
# service_role-nyckeln eller databaslösenordet här eller i klientkod.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
